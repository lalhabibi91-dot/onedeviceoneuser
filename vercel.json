{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": "{assets/**,icons/**,images/**,font/**,fonts/**,*.html,*.css,*.js,*.json,*.webmanifest}"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/server.js"
    }
  ]
}
